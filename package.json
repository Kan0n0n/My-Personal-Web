{
  "name": "philine-picturebook",
  "version": "3.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env scripts/serve.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "db:owner": "node --env-file-if-exists=.env scripts/owner.mjs",
    "test": "npm run build && node tests/frontend.mjs && node tests/frontend-check.mjs && node tests/development.mjs && node tests/request-body.mjs && node tests/database.mjs && node tests/music-api.mjs && node --experimental-vm-modules tests/novel-reader.mjs && node tests/reading-position.mjs && node tests/reader-speech.mjs",
    "dev": "node --env-file-if-exists=.env scripts/serve.mjs --dev",
    "build": "node scripts/build.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "express": "^5.3.0",
    "fflate": "^0.8.3",
    "pdfjs-dist": "^6.5.438",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  }
}
