# Copy to .env. Never commit real credentials.
DATABASE_URL=postgresql://picturebook_app:CHANGE_ME@127.0.0.1:5432/picturebook
# Optional elevated connection used ONLY by db:migrate and db:owner.
MIGRATION_DATABASE_URL=
# Used only by the optional local Docker Compose database.
POSTGRES_ADMIN_PASSWORD=CHANGE_ME_LOCAL_DATABASE_ADMIN_PASSWORD
APP_ORIGIN=http://127.0.0.1:4173
HOST=127.0.0.1
PORT=4173
NODE_ENV=development
# Set a random secret of at least 32 characters, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IMPORT_SIGNING_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS
SITE_OWNER_LOGIN=philine
SESSION_DAYS=7
